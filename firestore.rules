rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user document exists
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: fetch the calling user's Firestore profile
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check if owner (super admin) using token email or document role
    function isOwner() {
      return isAuthenticated() && 
        (request.auth.token.email == 'neoissa@gmail.com' ||
         (hasUserDoc() && (userDoc().role == 'owner' || userDoc().isOwner == true)));
    }

    // Helper: check if leader
    function isLeader() {
      return isAuthenticated() && 
        (isOwner() || (hasUserDoc() && userDoc().role == 'leader'));
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isOwner();

      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      }
    }

    // 2. Groups collection (Patrols)
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 3. Scout progress & requirements (ranks, merit badges, islamic basics, assignments, etc.)
    match /user_progress/{scoutId}/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 4. Weekly Lesson Plans
    match /lesson_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Homework & Task Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 6. Planned Events & Troop Calendar
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 7. Group Resources & Video Links
    match /group_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Private leader notes & logs
    match /scout_notes/{scoutId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Chat room messages (Patrol Messenger)
    match /chats/{roomId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Service hours logs
    match /service_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback rule for any custom collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
