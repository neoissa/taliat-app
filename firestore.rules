rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the calling user's Firestore profile
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Users may read their own profile. Leaders may read profiles assigned to them
    // and create scout profiles belonging to themselves.
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || (userDoc().role == 'leader'
                          && resource.data.leaderId == request.auth.uid));

      allow create: if request.auth != null
                    && userDoc().role == 'leader'
                    && request.resource.data.role == 'scout'
                    && request.resource.data.leaderId == request.auth.uid;

      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Scoped patrol chat: /chats/{leaderId}/messages/{messageId}
    // A scout (or leader) may only access the room whose leaderId matches
    // the leaderId stored in their own user document.
    match /chats/{leaderId}/messages/{messageId} {
      allow read: if request.auth != null
                  && userDoc().leaderId == leaderId;

      allow create: if request.auth != null
                    && userDoc().leaderId == leaderId
                    // Enforce the message carries the correct leaderId field
                    && request.resource.data.leaderId == leaderId
                    // Sender can only write as themselves
                    && request.resource.data.senderId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
