rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user document exists
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: fetch the calling user's Firestore profile
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check if owner (super admin) using token email or document role
    function isOwner() {
      return request.auth != null && 
        (request.auth.token.email == 'neoissa@gmail.com' ||
         (hasUserDoc() && (userDoc().role == 'owner' || userDoc().isOwner == true)));
    }

    // Helper: check if scoutmaster
    function isScoutmaster() {
      return request.auth != null && 
        hasUserDoc() &&
        userDoc().role == 'leader' && 
        userDoc().leaderPosition == 'Scoutmaster';
    }

    // Helper: check if assistant leader
    function isAssistantLeader() {
      return hasUserDoc() && 
        userDoc().role == 'leader' && 
        (userDoc().leaderPosition == 'Assistant Scoutmaster' || userDoc().leaderPosition == 'Assistant Leader');
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || isOwner()
                      || isScoutmaster()
                      || (hasUserDoc() && (
                          userDoc().role == 'leader'
                          || (userDoc().role == 'scout' && userId == userDoc().leaderId)
                         )));

      allow create: if request.auth != null
                    && (isOwner()
                        || isScoutmaster()
                        || (hasUserDoc() && userDoc().role == 'leader'
                            && !isAssistantLeader()
                            && request.resource.data.role == 'scout'
                            && request.resource.data.leaderId == request.auth.uid));

      allow update: if request.auth != null
                    && (request.auth.uid == userId || isOwner() || isScoutmaster());

      allow delete: if request.auth != null && isOwner();

      match /private/secrets {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isOwner());
      }
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }

    // Scout progress: generic progress categories (ranks, merit badges, safety videos, etc.)
    match /user_progress/{scoutId}/{progressType}/{docId} {
      allow read, write: if request.auth != null
                         && (request.auth.uid == scoutId
                             || isOwner()
                             || isScoutmaster()
                             || (hasUserDoc() && userDoc().role == 'leader'
                                 && exists(/databases/$(database)/documents/users/$(scoutId))
                                 && get(/databases/$(database)/documents/users/$(scoutId)).data.leaderId == request.auth.uid));
    }

    // Private leader notes
    match /scout_notes/{scoutId} {
      allow read, write: if request.auth != null
                         && (isOwner()
                             || isScoutmaster()
                             || (hasUserDoc() && userDoc().role == 'leader'
                                 && exists(/databases/$(database)/documents/users/$(scoutId))
                                 && get(/databases/$(database)/documents/users/$(scoutId)).data.leaderId == request.auth.uid));
    }

    // Chat room messages scoped by roomId (GroupId or Tali3a)
    match /chats/{roomId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.senderId == request.auth.uid;
      allow delete: if request.auth != null 
                    && (isOwner() || (hasUserDoc() && userDoc().role == 'leader'));
      allow update: if false;
    }

    // Weekly Lesson Plans
    match /lesson_plans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isOwner() || (hasUserDoc() && userDoc().role == 'leader'));
    }

    // Group Resources
    match /group_resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isOwner() || (hasUserDoc() && userDoc().role == 'leader'));
    }
  }
}
