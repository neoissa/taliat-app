rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the calling user's Firestore profile
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check if owner (super admin) using token email or document role
    function isOwner() {
      return request.auth != null && 
        (request.auth.token.email == 'neoissa@gmail.com' ||
         userDoc().role == 'owner' || 
         userDoc().isOwner == true);
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || isOwner()
                      || (userDoc().role == 'leader'
                          && resource.data.leaderId == request.auth.uid));

      allow create: if request.auth != null
                    && (isOwner()
                        || (userDoc().role == 'leader'
                            && request.resource.data.role == 'scout'
                            && request.resource.data.leaderId == request.auth.uid));

      allow update: if request.auth != null
                    && (request.auth.uid == userId || isOwner());

      allow delete: if request.auth != null && isOwner();
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }

    // Scout progress: ranks and merit badges
    match /user_progress/{scoutId}/ranks/{rankId} {
      allow read, write: if request.auth != null
                         && (request.auth.uid == scoutId
                             || isOwner()
                             || (userDoc().role == 'leader'
                                 && get(/databases/$(database)/documents/users/$(scoutId)).data.leaderId == request.auth.uid));
    }

    match /user_progress/{scoutId}/merit_badges/{badgeId} {
      allow read, write: if request.auth != null
                         && (request.auth.uid == scoutId
                             || isOwner()
                             || (userDoc().role == 'leader'
                                 && get(/databases/$(database)/documents/users/$(scoutId)).data.leaderId == request.auth.uid));
    }

    // Private leader notes
    match /scout_notes/{scoutId} {
      allow read, write: if request.auth != null
                         && (isOwner()
                             || (userDoc().role == 'leader'
                                 && get(/databases/$(database)/documents/users/$(scoutId)).data.leaderId == request.auth.uid));
    }

    // Chat room messages
    match /chats/{leaderId}/messages/{messageId} {
      allow read: if request.auth != null
                  && (isOwner()
                      || userDoc().leaderId == leaderId
                      || request.auth.uid == leaderId);

      allow create: if request.auth != null
                    && (isOwner()
                        || userDoc().leaderId == leaderId
                        || request.auth.uid == leaderId)
                    && request.resource.data.senderId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
