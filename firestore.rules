rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user document exists
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: fetch the calling user's Firestore profile
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check if owner (super admin) using token email or document role
    function isOwner() {
      return isAuthenticated() && 
        (request.auth.token.email == 'neoissa@gmail.com' ||
         (hasUserDoc() && (userDoc().role == 'owner' || userDoc().isOwner == true)));
    }

    // Helper: check if executive (owner, admin, scoutmaster, assistant scoutmaster)
    function isExecutive() {
      return isAuthenticated() && 
        (isOwner() || 
         (hasUserDoc() && (
           userDoc().role == 'admin' || 
           (userDoc().role == 'leader' && (
             userDoc().leaderPosition == 'Scoutmaster' || 
             userDoc().leaderPosition == 'Assistant Scoutmaster'
           ))
         )));
    }

    // Helper: check if leader
    function isLeader() {
      return isAuthenticated() && 
        (isExecutive() || (hasUserDoc() && userDoc().role == 'leader'));
    }

    // Helper: check if parent
    function isParent() {
      return isAuthenticated() && hasUserDoc() && userDoc().role == 'parent';
    }

    // Helper: check if parent of scout
    function isParentOf(scoutId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(scoutId)) &&
         ('parentUids' in get(/databases/$(database)/documents/users/$(scoutId)).data) &&
         request.auth.uid in get(/databases/$(database)/documents/users/$(scoutId)).data.parentUids) ||
        (hasUserDoc() && ('linkedScoutIds' in userDoc()) && scoutId in userDoc().linkedScoutIds)
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to update their own profile (e.g. parents updating dual-parent info), or leaders/admins updating users
      allow create, update: if isAuthenticated();
      allow delete: if isExecutive();

      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isExecutive());
      }
    }

    // 2. Groups collection (Patrols)
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isExecutive() || isLeader();
    }

    // 3. Scout progress & requirements (ranks, merit badges, islamic basics, assignments, etc.)
    match /user_progress/{scoutId}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && !isParent();
    }

    // 4. Attendance Sessions
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isLeader() || isExecutive();
    }

    // 5. Parent Attendance Excuses / Absence Notices
    match /attendance_excuses/{excuseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isLeader() || isExecutive();
    }

    // 6. Parent Tasks & Required Waivers Registry
    match /parent_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isExecutive() || isLeader();
    }

    // 7. Parent Task Submissions
    match /parent_task_submissions/{subId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Parent Notifications & In-App Alerts Feed
    match /parent_notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 9. Troop Broadcasts & Global Announcements
    match /troop_broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow write: if isExecutive();
    }

    // 10. Weekly Lesson Plans
    match /lesson_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 11. Homework & Task Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 12. Planned Events, Troop Calendar & RSVPs
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isExecutive() || isLeader();

      match /rsvps/{rsvpId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // 13. Group Resources & Video Links
    match /group_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 14. Private leader notes & logs
    match /scout_notes/{scoutId} {
      allow read, write: if isAuthenticated();
    }

    // 15. Chat room messages (Patrol Messenger)
    match /chats/{roomId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 16. Service hours logs
    match /service_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // 17. Mail collection for triggering notification emails
    match /mail/{mailId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback rule for any custom collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
